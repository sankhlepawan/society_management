{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@components": ["./src/components/*"],
      "@pages": ["./src/pages/*"],
      "@hooks": ["./src/hooks/*"],
      "@utils": ["./src/utils/*"],
      "@context": ["./src/context/*"],
      "@data": ["./src/data/*"]
    },
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}
